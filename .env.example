# MongoDB
MONGODB_URI=mongodb://mongodb:27017/lms

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
AUTH_ALLOWED_HOSTS=local.lms.me:3000,localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Owner emails (comma-separated). Day-to-day admin access is a role recorded
# on the user, not this list — this only gates who can grant/revoke that role,
# create a school and grant its admins, and use the schools console.
ADMIN_EMAILS=votrungquan99@gmail.com

# Closed by default (BUG-1): proxy.ts refuses a direct POST to the sign-up
# endpoint unless this is "true". Only the dev:e2e script sets it — accounts
# are otherwise created in-process (bulk import, invite-link self-signup).
# ALLOW_PUBLIC_SIGNUP=true

# Trusted Origins (comma-separated)
TRUSTED_ORIGINS=http://local.lms.me:3000

# Google Gemini (AiGradeService free-text grading, and document import when
# AI_IMPORT_PROVIDER=gemini)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key-here

# Document import: which AI reads uploads. "claude" (default) or "gemini".
# AI_IMPORT_PROVIDER=claude
# CLAUDE_MODEL_ID=claude-sonnet-5-5
# Anthropic key for the Claude import. Set it in the host's env (Vercel) or the
# shell, not in .env.local, so a local file never holds a paid key.
# ANTHROPIC_API_KEY=

# Every AI provider request is also appended to this file (JSON lines) on
# local runs; never written on Vercel.
# AI_USAGE_FILE=tmp/ai-usage.jsonl

# Grafana Cloud
# OTEL_LOG_LEVEL=warn shows OTLP export failures in the terminal (set by the
# dev scripts).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
GRAFANA_CLOUD_API_KEY=

# S3 (question media storage). Always required:
S3_BUCKET_NAME=your-question-media-bucket
AWS_REGION=ap-southeast-1
# Auth — pick ONE path:
#   Production/preview (Vercel): keyless OIDC. AWS_ROLE_ARN is injected by
#   personal-infra; the app assumes it via the Vercel OIDC token (no static keys).
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/lms-s3-access
#   Local dev / non-Vercel fallback: static IAM keys (leave AWS_ROLE_ARN unset).
#   Quick fill: in the personal-infra repo run `bun run lms:env >> ../lms/.env`
#   to append S3_BUCKET_NAME + AWS_REGION + the keys below from Pulumi outputs.
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# CloudFront signed-URL media delivery (reads). Set all three together, or none.
# Injected by personal-infra in production/preview; when unset, reads fall back to
# S3 presigned GET URLs (fine for local dev).
# CLOUDFRONT_DOMAIN=d111abc.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=K1234567890ABC
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
