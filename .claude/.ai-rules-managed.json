{
  "version": 1,
  "managedHooks": {
    "kanban-track": {
      "event": "UserPromptSubmit",
      "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/kanban-track/kanban-track.mjs",
      "scriptPath": ".claude/hooks/kanban-track/kanban-track.mjs"
    },
    "spec-reminder": {
      "event": "Stop",
      "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spec-reminder/spec-reminder.mjs",
      "scriptPath": ".claude/hooks/spec-reminder/spec-reminder.mjs"
    },
    "flush-debt": {
      "event": "Stop",
      "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/flush-debt/flush-debt.mjs",
      "scriptPath": ".claude/hooks/flush-debt/flush-debt.mjs"
    }
  }
}
